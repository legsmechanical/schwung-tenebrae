{
  "id": "tenebrae",
  "name": "Tenebrae",
  "abbrev": "TNBR",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Macro synth for synthwave, darksynth and darkwave. Eight oscillator models shaped by Shape, Stack and Age, a gritty state-variable filter with two-stage drive, and a cinematic effects chain: chorus, phaser, tempo pump, VHS, tape delay and shimmer reverb. 160 presets.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
      {"key":"model","name":"Osc Model","type":"enum","default":0,"options":["Saw","Pulse","Sync","FM","Bell","Wave","Vox","Zap"]},
      {"key":"shape","name":"Shape","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"shape_env","name":"Shape Env","type":"float","min":-1,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"stack","name":"Stack","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"layer","name":"Layer","type":"enum","default":1,"options":["Sub Sine","Sub Square","Sub -2 Oct","Octave Down","Fifth Up","Octave Up","2 Oct Up","Noise"]},
      {"key":"blend","name":"Layer Blend","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"age","name":"Age","type":"float","min":0,"max":1,"step":0.01,"default":0.2,"unit":"%"},
      {"key":"voice","name":"Voice / Glide","type":"enum","default":0,"options":["Poly","Mono","Glide 10ms","Glide 20ms","Glide 30ms","Glide 45ms","Glide 60ms","Glide 80ms","Glide 110ms","Glide 150ms","Glide 200ms","Glide 270ms","Glide 360ms","Glide 480ms","Glide 650ms","Glide 900ms","Glide 1.2s","Glide 1.6s"]},
      {"key":"flt_type","name":"Filter Type","type":"enum","default":0,"options":["LP24","LP12","BP","HP"]},
      {"key":"cutoff","name":"Cutoff","type":"float","min":0,"max":1,"step":0.01,"default":0.62,"unit":"%"},
      {"key":"reso","name":"Resonance","type":"float","min":0,"max":1,"step":0.01,"default":0.15,"unit":"%"},
      {"key":"drive","name":"Drive","type":"float","min":0,"max":1,"step":0.01,"default":0.2,"unit":"%"},
      {"key":"flt_env","name":"Filter Env Amt","type":"float","min":-1,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"flt_a","name":"Filter Attack","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"flt_d","name":"Filter Decay","type":"float","min":0,"max":1,"step":0.01,"default":0.45,"unit":"%"},
      {"key":"flt_s","name":"Filter Sustain","type":"float","min":0,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"lfo_dest","name":"LFO Target","type":"enum","default":0,"options":["Pitch","Shape","Filter","Amp","Pan","Filter S&H","Filter Sync Ramp"]},
      {"key":"lfo_rate","name":"LFO Rate","type":"float","min":0,"max":1,"step":0.01,"default":0.55,"unit":"%"},
      {"key":"lfo_depth","name":"LFO Depth","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"vel","name":"Velocity","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"amp_a","name":"Amp Attack","type":"float","min":0,"max":1,"step":0.01,"default":0.02,"unit":"%"},
      {"key":"amp_d","name":"Amp Decay","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"amp_s","name":"Amp Sustain","type":"float","min":0,"max":1,"step":0.01,"default":0.8,"unit":"%"},
      {"key":"amp_r","name":"Amp Release","type":"float","min":0,"max":1,"step":0.01,"default":0.35,"unit":"%"},
      {"key":"cho_mode","name":"Chorus Type","type":"enum","default":0,"options":["I","II","I+II","Ensemble","Dimension"]},
      {"key":"cho_mix","name":"Chorus Mix","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"phs_rate","name":"Phaser Rate","type":"float","min":0,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"phs_depth","name":"Phaser Depth","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"pump_rate","name":"Pump Rate","type":"enum","default":1,"options":["1/2","1/4","1/8","1/16"]},
      {"key":"pump","name":"Pump Depth","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"vhs","name":"VHS","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"tone","name":"Tone","type":"float","min":-1,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"dly_time","name":"Delay Time","type":"enum","default":3,"options":["1/16","1/8T","1/8","1/8 Dot","1/4","1/4 Dot","1/2"]},
      {"key":"dly_fb","name":"Delay Feedback","type":"float","min":0,"max":1,"step":0.01,"default":0.4,"unit":"%"},
      {"key":"dly_mix","name":"Delay Mix","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"level","name":"Level","type":"float","min":0,"max":1,"step":0.01,"default":0.7,"unit":"%"},
      {"key":"rev_size","name":"Reverb Size","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"rev_tone","name":"Reverb Color","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"shimmer","name":"Shimmer","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"rev_mix","name":"Reverb Mix","type":"float","min":0,"max":1,"step":0.01,"default":0.15,"unit":"%"}
    ]
  }
}
